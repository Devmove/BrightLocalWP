{
  "name": "bright-local-wp",
  "productName": "BrightLocalWP",
  "version": "0.1.0",
  "slug": "brightlocalwp",
  "bgColor": "#2271b1",
  "icon": "icon.svg",
  "brightLocalWP": {
    "localAddonPath": "~/.config/Local/addons/bright-local-wp"
  },
  "description": "Ferramentas de manutenção e limpeza para ambientes do Local.",
  "main": "dist/main.js",
  "renderer": "dist/renderer.js",
  "bin": {
    "brightlocalwp": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "dev:install": "npm run build && node scripts/install-addon.cjs",
    "lint": "eslint .",
    "package": "npm run build && node scripts/package.cjs",
    "test": "node --test --import tsx",
    "test:watch": "node --test --import tsx --watch"
  },
  "keywords": [
    "localwp",
    "local",
    "wordpress",
    "addon"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@getflywheel/local": "^9.2.4",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "tar": "^7.4.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
